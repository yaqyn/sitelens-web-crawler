Screen { background: $background; color: $foreground; align-horizontal: center; }
#masthead { dock: top; height: 3; padding: 1 2; background: $panel; color: $accent; text-style: bold; content-align-horizontal: center; }
#workspace { width: 100%; max-width: 96; height: 1fr; padding: 1 2; }
#tabs { height: 1fr; }
ContentSwitcher { height: 1fr; }
TabPane { height: 1fr; overflow-y: auto; padding: 0 1; scrollbar-size: 1 1; }
#title { height: 1; text-style: bold; color: $primary; content-align-horizontal: center; }
#intro { height: 2; content-align-horizontal: center; margin-top: 1; }
.section { height: auto; color: $accent; text-style: bold; margin: 1 0; }
.field-label { width: 100%; height: auto; margin-top: 1; }
Input, Select { width: 100%; }
Input:focus { border: heavy $primary; }
Checkbox { margin-top: 1; }
#bottom-dock { dock: bottom; width: 100%; height: 6; align-horizontal: center; }
#bottom-bar { width: 100%; max-width: 96; height: 6; background: $background; padding: 0 2; }
#actions { height: 3; align-horizontal: center; }
#keys { height: 2; grid-size: 4 2; grid-rows: 1; grid-columns: 1fr; margin-top: 1; }
#keys Static { height: 1; text-wrap: nowrap; text-overflow: ellipsis; color: $foreground; }
Button { margin: 0 1; min-width: 15; }
Button:focus { text-style: bold reverse; }
#status { height: auto; padding: 1; border-left: thick $primary; background: $panel; }
#counts { height: auto; margin: 1 0; }
#log { height: 1fr; min-height: 4; border: solid $secondary; background: $surface; }
.compact #workspace { padding: 0 1; }
.compact .field-label { margin-top: 0; }
.compact .section { margin: 0; }
.narrow #workspace { padding: 0 1; }
.narrow #intro { display: none; }
.narrow #bottom-dock { height: 8; }
.narrow #bottom-bar { height: 8; padding: 0 1; }
.narrow #keys { height: 4; grid-size: 2 4; }
HelpScreen { align: center middle; background: $background 80%; }
#help-dialog { width: 72; max-width: 95%; height: auto; max-height: 90%; overflow-y: auto; padding: 1 2; background: $panel; border: heavy $primary; }
#help-dialog Static { height: auto; }
#help-dialog Button { margin-top: 1; }

#limits { height: 10; grid-size: 2 2; grid-rows: 5; grid-columns: 1fr; grid-gutter: 0 2; }
.limit-field { height: 5; }
.narrow #limits { height: 20; grid-size: 1 4; }
